#!/usr/bin/env bash
# Refuses a push whose commits carry AI attribution (owner's rule; the
# review workflow commit-hygiene.yml enforces the same on the server).
# Install: git config core.hooksPath hooks
set -euo pipefail
zero=0000000000000000000000000000000000000000
bad='^(Co-Authored-By: .*(Claude|anthropic|noreply@anthropic\.com|Copilot|GPT|OpenAI)|.*Generated with \[?Claude|Claude-Session:|.*claude\.ai/code)'
status=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
  for c in $(git rev-list "$range"); do
    if git log -1 --format='%B%n%an <%ae>%n%cn <%ce>' "$c" | grep -Eiq "$bad"; then
      echo "pre-push: $c carries AI attribution; rewrite its message before pushing." >&2
      status=1
    fi
  done
done
exit $status
